        "#ขั้นที่ 2 ออกแบบ\n",
        "class DrinkOrder:\n",
        "  def __init__(self, order_id, customer_name, menu_name, drink_type, size, topping, sweetness_level):\n",
        "    self.order_id = order_id\n",
        "    self.customer_name = customer_name\n",
        "    self.menu_name = menu_name\n",
        "    self.drink_type = drink_type\n",
        "    self.size = size\n",
        "    self.topping = topping\n",
        "    self.sweetness_level = sweetness_level #ระดับความหวาน: 0%, 25%, 50%, 100%, 125% (ไม่คิดเงิน)\n",
        "    self.status = \"รอดำเนินการ\"\n",
        "\n",
        "  def calculate_price(self):\n",
        "    base_prices = {\n",
        "        # กาแฟ\n",
        "        \"อเมริกาโน่\" : 45,\n",
        "        \"ลาเต้\" : 50,\n",
        "        \"คาปูชิโน่\" : 50,\n",
        "        \"เอสเพรสโซ่\" : 50,\n",
        "        \"มอคค่า\" : 50,\n",
        "\n",
        "        # ชาและนม\n",
        "        \"ชาเขียว\" : 45,\n",
        "        \"ชาไทย\" : 45,\n",
        "        \"มัทฉะลาเต้\" : 50,\n",
        "        \"ช็อกโกแลต\" : 50,\n",
        "        \"นมสด\" : 40,\n",
        "\n",
        "        # โซดา\n",
        "        \"สตอว์เบอร์รี่โซดา\" : 40,\n",
        "        \"บลูฮาวายโซดา\" : 40,\n",
        "        \"ยูซุโซดา\" : 40\n",
        "    }\n",
        "\n",
        "    type_prices = {\n",
        "        \"ร้อน\" : 0,\n",
        "        \"เย็น\" : 5,\n",
        "        \"ปั่น\" : 10\n",
        "    }\n",
        "\n",
        "    size_prices = {\n",
        "        \"S\" : 0,\n",
        "        \"M\" : 10,\n",
        "        \"L\" : 20\n",
        "    }\n",
        "\n",
        "    topping_prices = {\n",
        "        \"ไม่มี\" : 0,\n",
        "        \"ไข่มุก\" : 5,\n",
        "        \"วิปครีม\" : 15,\n",
        "        \"ครีมชีส\" : 20\n",
        "    }\n",
        "\n",
        "    total = base_prices[self.menu_name] + type_prices[self.drink_type] + size_prices[self.size] + topping_prices[self.topping]\n",
        "    return total\n",
        "\n",
        "  def make_done(self):\n",
        "   self.status = \"เสร็จแล้ว\""
      ],
